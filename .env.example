# =========================================================================
# Note Nest / Hify Server Environment Variables
# =========================================================================

# Server Configuration
PORT=5000
JWT_SECRET=super_secret_jwt_key_note_nest_neumorphic_2026
DATA_DIR=data

# PostgreSQL Database Connection
# Option 1: Full Connection String URL (Recommended)
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/notenest

# Option 2: Individual Connection Parameters
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGDATABASE=notenest
# PGSSL=false

# Google OAuth 2.0 Client ID (Web Application)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
